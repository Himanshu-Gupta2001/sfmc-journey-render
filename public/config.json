{
  "workflowApiVersion": "1.1",
  "metaData": {
    "icon": "https://YOUR_APP_URL.onrender.com/icon.png",
    "category": "custom"
  },
  "type": "REST",
  "lang": {
    "en-US": {
      "name": "Form Processor",
      "description": "Calls Cloud Page 2 for backend form processing"
    }
  },
  "arguments": {
    "execute": {
      "inArguments": [
        { "emailAddress": "" },
        { "firstName": "" }
      ],
      "url": "https://YOUR_APP_URL.onrender.com/execute",
      "timeout": 10000,
      "retryCount": 2,
      "retryDelay": 1000,
      "concurrentRequests": 5
    }
  },
  "configurationArguments": {
    "publish":  { "url": "https://YOUR_APP_URL.onrender.com/publish" },
    "validate": { "url": "https://YOUR_APP_URL.onrender.com/validate" },
    "stop":     { "url": "https://YOUR_APP_URL.onrender.com/stop" }
  },
  "userInterfaces": {
    "configModal": {
      "url": "https://YOUR_APP_URL.onrender.com/",
      "height": 200,
      "width": 400
    }
  }
}
